(version 1)
# PCBWay standard 2-layer process, 1.6 mm FR-4, 1 oz copper, HASL lead-free or ENIG.
# Everything here is inside PCBWay's no-extra-cost limits, so the board quotes at the
# base price. Board setup (kicad_pro) carries the same minimums.

(rule "PCBWay min track width"
  (constraint track_width (min 0.15mm)))

(rule "PCBWay min copper clearance"
  (condition "A.Type != 'Zone' && B.Type != 'Zone'")
  (constraint clearance (min 0.15mm)))

(rule "Zone clearance"
  (condition "A.Type == 'Zone' || B.Type == 'Zone'")
  (constraint clearance (min 0.25mm)))

(rule "PCBWay min drill"
  (constraint hole_size (min 0.3mm)))

(rule "PCBWay min annular ring"
  (constraint annular_width (min 0.15mm)))

(rule "PCBWay via diameter"
  (condition "A.Type == 'Via'")
  (constraint via_diameter (min 0.6mm)))

(rule "PCBWay hole to hole"
  (constraint hole_to_hole (min 0.5mm)))

(rule "PCBWay hole to copper"
  (constraint hole_clearance (min 0.25mm)))

(rule "PCBWay copper to board edge"
  (constraint edge_clearance (min 0.3mm)))

(rule "PCBWay silkscreen line"
  (layer "?.Silkscreen")
  (constraint text_thickness (min 0.15mm))
  (constraint text_height (min 0.8mm)))

# The LED strings and the battery input carry up to 1 A (0.67 A as built); keep them wide.
(rule "LED and battery current"
  (condition "A.NetClass == 'Power'")
  (constraint track_width (min 0.5mm)))

# 25 V across the input: a little more air between battery nets and logic.
(rule "Battery to logic"
  (condition "A.NetClass == 'Power' && B.NetClass == 'Default'")
  (constraint clearance (min 0.2mm)))

# RM2 antenna: nothing copper near the module's antenna end.
(rule "Antenna keep-out"
  (condition "A.insideArea('Antenna keep-out')")
  (constraint disallow track via zone))
