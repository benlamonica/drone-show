(version 1)

# Custom rules for the drone-show 4-layer ESC. The PCBWay fab minimums
# (0.178/0.2 mm track/space at 2 oz, 0.66/0.3 mm via, 0.3 mm to the edge) live in
# drone-esc.kicad_pro, written by tools/project_settings.py.

(rule "silkscreen off pads"
  (constraint silk_clearance (min 0.15mm))
  (condition "A.Type == 'Pad'"))

# Phase, battery and +BATT copper sees 25 V steps at the PWM frequency. The
# pours keep 0.3 mm from other nets (set on each zone); tracks and pads use the
# fab minimum.

# Fine-pitch QFN pads (0.4 mm pitch MCU) are 0.2 mm apart. That is the fab
# minimum, so tracks escaping them are allowed down to it.
(rule "QFN escape"
  (constraint clearance (min 0.2mm))
  (condition "A.Type == 'Pad' && A.Parent.Value == 'AT32F421G8U7'"))
