(version 1)

# Custom rules for the drone-show 2-layer ESC. The PCBWay fab minimums
# (0.2 mm track/space at 2 oz, 0.6/0.3 mm via, 0.3 mm to the edge) live in
# drone-esc.kicad_pro, written by tools/project_settings.py.

(rule "silkscreen off pads"
  (constraint silk_clearance (min 0.15mm))
  (condition "A.Type == 'Pad'"))

# Phase, battery and +BATT copper sees 25 V steps at the PWM frequency; keep a
# bit more air between it and anything else.
(rule "power copper clearance"
  (constraint clearance (min 0.3mm))
  (condition "A.NetClass == 'Power' && A.Net != B.Net && B.Type != 'Pad'"))

# Fine-pitch QFN pads (0.4 mm pitch MCU) are 0.2 mm apart. That is the fab
# minimum, so tracks escaping them are allowed down to it.
(rule "QFN escape"
  (constraint clearance (min 0.2mm))
  (condition "A.Type == 'Pad' && A.Parent.Value == 'AT32F421G8U7'"))

# Mounting holes take metal standoffs or grommets: no other copper within
# 0.5 mm of the plated ring.
(rule "mounting hole ring"
  (constraint clearance (min 0.5mm))
  (condition "A.Type == 'Pad' && A.Pad_Number == '11' && A.Parent.Reference == 'U3' && A.Net != B.Net"))
